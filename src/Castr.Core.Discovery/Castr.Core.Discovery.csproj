<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      M4 / ADR-0002 multi-targeting. The canonical target set for this library is:
          net10.0 ; net10.0-android ; net10.0-ios
      The two mobile heads require their .NET workloads to be installed (and the Android head
      additionally requires the Android command-line SDK + a JDK, which the `android` workload does
      NOT itself provide). Building a head whose tooling is absent fails the build.

      The repo rule is that a plain `dotnet build` of the whole solution must stay green everywhere,
      including the cross-OS CI matrix (ubuntu/windows/macos), which installs NO mobile workloads.
      So the mobile heads are OPT-IN via the CastrMobileTargets property:

          dotnet build ... -p:CastrMobileTargets=true

      That is what per-TFM verification and the future dedicated mobile-CI phase use. A plain build
      (and therefore the existing CI matrix and the desktop solution build) compiles the net10.0 head
      only and never touches the mobile toolchains. The platform implementations
      (NsdServiceDiscovery.Android.cs / NetworkServiceDiscovery.iOS.cs) and this multi-targeting are
      fully authored either way — the flag only controls which heads a given build actually compiles.

      CastrAndroidTarget / CastrIosTarget are narrower single-platform variants of the same switch.
      They exist because restore (not just build) evaluates THIS project's own TargetFrameworks using
      THIS project's own global properties — a downstream ProjectReference's SetTargetFramework or
      AdditionalProperties overrides only how the CONSUMER selects among already-restored frameworks,
      it cannot retroactively add a framework that this project's own restore never evaluated (that
      was a real bug: the Android CI leg tried exactly that and got NETSDK1005, "assets file doesn't
      have a target for net10.0-android", even though the consumer-side reference override was
      correct). The dedicated Android CI runner has no ios workload installed at all, so a plain
      CastrMobileTargets=true there would break restore outright trying to evaluate net10.0-ios; the
      dedicated iOS CI runner installs both workloads (see ci-mobile-ios.yml) so it can keep using the
      combined CastrMobileTargets=true flag unchanged.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CastrMobileTargets)' == 'true'">net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(CastrMobileTargets)' != 'true' And '$(CastrAndroidTarget)' == 'true'">net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(CastrMobileTargets)' != 'true' And '$(CastrIosTarget)' == 'true'">net10.0;net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Platform-conditional compilation.

    Files follow the SDK filename-suffix convention: *.Android.cs and *.iOS.cs. We do NOT rely on
    the MAUI SDK's automatic suffix exclusion (this is a plain Microsoft.NET.Sdk library, which does
    not exclude by suffix on its own), so exclusion is done explicitly here, keyed off the standard
    $(TargetPlatformIdentifier) MSBuild property (empty for net10.0, 'android' / 'ios' otherwise).
    Everything without a platform suffix (interface, records, constants, in-memory fake) compiles
    into all three TFMs.
  -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'android'">
    <Compile Remove="**\*.Android.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'ios'">
    <Compile Remove="**\*.iOS.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Castr.Core\Castr.Core.csproj" />
  </ItemGroup>

</Project>
