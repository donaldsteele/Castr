<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:versionCode="1"
          android:versionName="1.0">

    <!--
      Permissions for the unicast-swarm client (M4 research, see NsdServiceDiscovery.Android.cs header):
      NsdManager service discovery needs only these three install-time / "normal" permissions — NO runtime
      prompt, and specifically NOT NEARBY_WIFI_DEVICES (that gates Wi-Fi Direct/Aware/RTT/LocalOnlyHotspot,
      not NSD). INTERNET is also what the TCP pull needs.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Foreground-operation note: this v1 performs the discovery + pull while the app is in the FOREGROUND,
      which needs no extra permission. Sustaining a transfer while backgrounded would require a real
      foreground Service (started before backgrounding) declared with a data-sync type; the permissions for
      that are declared here so the manifest is ready, but the Service itself is NOT yet implemented — that is
      follow-up work and is called out honestly in the M4 report. POST_NOTIFICATIONS (Android 13+) would be
      requested at runtime to show the foreground-service notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="Castr" android:allowBackup="true" android:supportsRtl="true" />
</manifest>
