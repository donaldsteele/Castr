<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Castr.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="300"
        x:Class="Castr.Gui.Views.TrustPromptDialog"
        x:DataType="vm:TrustPromptViewModel"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Trust this sender?">

    <StackPanel Spacing="12" Margin="18">
        <TextBlock Text="Unknown sender" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="10">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding SenderId, StringFormat='Sender: {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TransferName, StringFormat='Transfer: {0}'}" />
                <TextBlock Text="{Binding FileCount, StringFormat='Files: {0}'}" />
                <TextBlock Text="{Binding TotalBytesText, StringFormat='Size: {0}'}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Reject" Command="{Binding RejectCommand}" />
            <Button Content="Trust and accept" Command="{Binding AcceptCommand}"
                    Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
