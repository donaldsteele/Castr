<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Castr.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="Castr.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="720" Height="520"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="12">

        <!-- ===== SEND ===== -->
        <TabItem Header="Send">
            <StackPanel Spacing="10" Margin="8" DataContext="{Binding Send}"
                        x:DataType="vm:SendViewModel">
                <TextBlock Text="Send a file to the LAN" FontSize="18" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" PlaceholderText="File to send…"
                             Text="{Binding FilePath}" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Chunk size (bytes):" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding ChunkSize}" Minimum="256" Maximum="60000"
                                   Increment="1024" Width="150" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start send" Command="{Binding StartCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="10"
                        IsVisible="{Binding Progress.HasProgress}">
                    <StackPanel Spacing="6" DataContext="{Binding Progress}"
                                x:DataType="vm:TransferProgressViewModel">
                        <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="18" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>

        <!-- ===== RECEIVE ===== -->
        <TabItem Header="Receive">
            <StackPanel Spacing="10" Margin="8" DataContext="{Binding Receive}"
                        x:DataType="vm:ReceiveViewModel">
                <TextBlock Text="Receive a file from the LAN" FontSize="18" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" PlaceholderText="Destination folder…"
                             Text="{Binding DestinationDirectory}" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Unknown senders:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PolicyChoices}"
                              SelectedIndex="{Binding SelectedPolicyIndex}" Width="280" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start listening" Command="{Binding StartCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

                <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="10"
                        IsVisible="{Binding Progress.HasProgress}">
                    <StackPanel Spacing="6" DataContext="{Binding Progress}"
                                x:DataType="vm:TransferProgressViewModel">
                        <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="18" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>

    </TabControl>
</Window>
