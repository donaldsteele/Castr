<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Shared Avalonia views/viewmodels library consumed by Castr.Gui.Desktop (and, in M4, the mobile heads). -->
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Castr.Core\Castr.Core.csproj" />
    <!-- M4: the mobile receive flow (MobileReceiveViewModel) browses for peers via IServiceDiscovery. -->
    <ProjectReference Include="..\Castr.Core.Discovery\Castr.Core.Discovery.csproj" />
  </ItemGroup>
</Project>
